# This input file is based on benchmark.rayleigh_taylor (no eb 3d)

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#                 TRAPS                 #
#.......................................#
amrex.fpe_trap_invalid   = 1
amrex.fpe_trap_zero      = 1
amrex.fpe_trap_overflow  = 1

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            SIMULATION STOP            #
#.......................................#
max_step                =   1000         # Max number of time steps
# stop_time  				=	1

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#         TIME STEP COMPUTATION         #
#.......................................#
incflo.fixed_dt         =   0.0001     # Use this constant dt if > 0
incflo.cfl              =   0.1         # CFL factor
incflo.init_shrink      =   1           # EY: What is this for?

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            INPUT AND OUTPUT           #
#.......................................#
amr.plot_int            =   10         # Steps between plot files
amr.plt_eta             =   1           # plot file for eta not real viscosity for inside pellet
amr.plt_tracer          =   1           # Temperature
amr.plt_cp_steel        =   1           # 
amr.plt_k_steel         =   1           # conductivity/cp (or mu_s)
amr.plt_rho_steel       =   1           # density Fe

amr.check_int           =  -1          # Steps between checkpoint files
# amr.restart             =   ""         # Checkpoint to restart from 

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#               PHYSICS                 #
#.......................................#
incflo.gravity              =  0.   0.  0.  # Gravitational force (3D)
incflo.ro_0                 =  1.0          # Turn off background state

incflo.fluid_model          =   "twoMu"     # Rheological model
# liquid Fe viscosity (should be real)
incflo.mu                   =   1.0         # Dynamic viscosity coefficient(kg/m*s)
incflo.n                    =   3           # For twoMu, this is eta mu*pow(10, incflo.n)

incflo.zero_vel             =   false        # imposing zero inside pellet vel.     
incflo.constant_density     =   true        # This density is not depending on Temp
incflo.advect_tracer        =   true        #
incflo.trac_is_conservative =      0        # conservative?

incflo.mu_s                 =   1.          # EY: This should not affect (replaced by k)

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#        ADAPTIVE MESH REFINEMENT       #
#.......................................#
amr.n_cell              =   16	16	16  # Grid cells at coarsest AMRlevel
amr.max_grid_size       =   8   8   8   # Max grid size at AMR levels
amr.blocking_factor     =   8           # Blocking factor for grids
amr.max_level           =   0           # Max AMR level in hierarchy 
amr.regrid_int          =   2
incflo.etaerr           =   10

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              GEOMETRY                 #
#.......................................#
# geometry.prob_lo        = -0.1  -0.1  -0.1 # Lo corner coordinates (m)
# geometry.prob_hi        =  0.1   0.1   0.1 # Hi corner coordinates

geometry.prob_lo        = -0.1  -0.1  0 # Lo corner coordinates (m)
geometry.prob_hi        =  .1   .1   1 # Hi corner coordinates
geometry.is_periodic    =  0	0	0  # Periodicity x y z (0/1)

# Boundary conditions
xlo.type                =   "mi"        #  mass inflow
xlo.tracer              =   0.0         #  inflow value of tracer
xlo.velocity            =   0.0  0. 0.    #  inflow value of tracer
xhi.type                =   "po"        #  pressure outflow
xhi.pressure            =   0.0
# xlo.type                =   "sw"
# xhi.type                =   "sw"
# xlo.velocity = 0.001
# xhi.velocity = 0.1
# # xlo.pressure = 1.0
# # xhi.pressure = 1.0
# # xlo.density = 1.0
# # xhi.density = 1.0

# # xlo.tracer = 990.0;
# # xhi.tracer = 1010.0;

ylo.type                =   "sw"
yhi.type                =   "sw"
ylo.tracer = 90.03320054
yhi.tracer = 109.966799462
ylo.velocity = 0.0
yhi.velocity = 0.0
# zlo.type                =   "nsw"
# zhi.type                =   "nsw"

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            Pellet properties          #
#.......................................#
prob.npellets           =   1
prob.pellet_rads        =   0.01
prob.pellet_centx       =   0.
prob.pellet_centy       =   0.
prob.pellet_centz       =   0.


#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#           INITIAL CONDITIONS          #
#.......................................#
incflo.probtype         =   200

# Value for Gaussian function (initial Temp)
# Liquid Fe (or slag or bath) temperature
prob.Tinit_liq          =   1500.0      # (1540.0+273.0) K
prob.sigX               =   0.01;
prob.sigY               =   0.01;
prob.sigZ               =   0.01;
prob.cc                 =   0.05;      # x 100 = % of the temp. difference

# incflo.ic_u             =   1        # (m/s)
# incflo.ic_v             =   0.001        # for now
# incflo.ic_w             =   0.0        #
# incflo.ic_p             =   0.0        #

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#                NUMERICS               #
#.......................................#
incflo.advection_type        = "Godunov"
incflo.diffusion_type        = 1        # 0 = Explicit, 1 = Crank-Nicolson, 2 = Implicit


#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              VERBOSITY                #
#.......................................#
incflo.verbose           =  2           # incflo itself
mac_proj.verbose         =  0           # MAC Projector
nodal_proj.verbose       =  0           # Nodal Projector
scalar_diffusion.verbose =  1           # Scalar Diffusion
tensor_diffusion.verbose =  0           # Tensor Diffusion

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#                EXTRA                  #
#.......................................#
# incflo.test_tracer_conservation = true
# don't do initial projection
# incflo.do_initial_pressure_proj = 0   # to enforce hydrostatic equilibrium
# let me try with a differnt inital time step multiplied by this number
# based on cfl
#find incflo.change_max -> set that with different number if necessary
# tensor_diffusion.mg_verbose  =  3       # Diffusion
# incflo.initial_iterations = 0